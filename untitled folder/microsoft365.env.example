# Template only. Copy outside the public website/project bundle and restrict to server owner (chmod 600).
# Load these variables in the CENTRAL SERVER launch environment, then restart Team_LAN.command.
export SHAMARA_M365_TENANT_ID='REPLACE-WITH-DIRECTORY-TENANT-GUID'
export SHAMARA_M365_CLIENT_ID='REPLACE-WITH-APPLICATION-CLIENT-GUID'
export SHAMARA_M365_CLIENT_SECRET='REPLACE-WITH-SECRET-VALUE'
export SHAMARA_M365_SENDER='purchase-notifications@example.com'
# Employees must be able to reach this LAN address and trust the server HTTPS certificate.
export SHAMARA_BASE_URL='https://YOUR-CENTRAL-SERVER:8765'
